/node_modules
/oh_modules
/local.properties
# 本地项目开发记录，不进入 Git。
/docs/项目开发记录/
# 本机签名配置由安全模板复制生成，不进入 Git。
/build-profile.json5
# 鸿蒙端原生库由源码构建，保留本机旧 Qt 运行库但不推送。
/entry/libs/
# 项目内 Qt 开发依赖及 PDFium 构建工具/缓存，由准备脚本生成。
/third_party/qt/bin/
/third_party/qt/include/
/third_party/qt/lib/
/third_party/qt/mkspecs/
/third_party/qt/plugins/
/third_party/qt/sdk.json
/.native-tools/
/third_party/.gclient*
/third_party/.cipd/
/third_party/.gcs_entries
/third_party/_bad_scm/
/entry/src/main/resources/rawfile/third_party_licenses/
# Python HNP 是本机打包产物；仓库只保存打包脚本和自检源码。
/hnp/**/*.hnp
/.hnp-cache/
# Python 本机语法检查缓存。
__pycache__/
*.pyc
# 覆盖本机全局忽略规则，保留鸿蒙打包脚本源码。
!/packaging/ohos/
/.idea
**/build
/.hvigor
.cxx
/.clangd
/.clang-format
/.clang-tidy
**/.test
/.appanalyzer
